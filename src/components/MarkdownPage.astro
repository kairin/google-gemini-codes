---
// MarkdownPage.astro
// Props: title, description, html (string)
interface Props {
  title: string;
  description: string;
  html: string;
}
const { title, description, html } = Astro.props;
---
<main class="prose mx-auto px-4 py-10">
  <h1>{title}</h1>
  <p>{description}</p>
  <hr />
  <div innerHTML={html} />
</main>
