---
// SitemapList.astro
// Props: items (array of { title: string, url: string })
interface Props {
  items: Array<{ title: string; url: string }>;
  title?: string;
}
const { items, title } = Astro.props;
import BaseLink from '@/components/BaseLink.astro';
---
{title && <h2 class="text-xl font-semibold mb-2">{title}</h2>}
<ul class="list-disc ml-6">
  {items.map(item => (
    <li><BaseLink href={item.url}>{item.title}</BaseLink></li>
  ))}
</ul>
