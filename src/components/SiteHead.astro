---
// src/components/SiteHead.astro
import DeploymentInfo from '@/components/DeploymentInfo.astro';
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<head>
  <meta charset="UTF-8" />
  <meta name="description" content="Astro description" />
  <meta name="viewport" content="width=device-width" />
  <!--
    Favicon is in public/, so reference it using the hardcoded subdirectory path for guaranteed correctness.
    Do NOT use Astro.base for favicon path due to repeated issues.
  -->
  <link rel="icon" type="image/svg+xml" href="/google-gemini-codes/favicon.svg" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <DeploymentInfo />
</head>
