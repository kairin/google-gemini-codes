---
// src/layouts/Layout.astro
import '../styles/global.css';
import SITE_DEPLOYMENT_INFO from '@/SITE_DEPLOYMENT_INFO.ts'; // Source of truth for deployment settings
import DeploymentInfo from '@/components/DeploymentInfo.astro'; // Deployment info component
import BaseLink from '@/components/BaseLink.astro'; // BaseLink component for navigation
import SiteHead from '@/components/SiteHead.astro'; // Reusable <head> component
import CommonFooterImports from '@/components/CommonFooterImports.astro'; // Common footer imports
// Favicon is in public/, so do NOT import it. Use Astro.base for the path.

interface Props {
	title: string;
}

const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
	<SiteHead title={title} />
	<body>
		<nav class="site-nav flex gap-6 py-4 px-6 border-b border-gray-200 mb-8">
			<BaseLink href="/">Home</BaseLink>
			<BaseLink href="/projects/astro-rebuild-guide/1">Projects</BaseLink>
			<BaseLink href="/blog/first-post/1">Blog</BaseLink>
			<BaseLink href="/sitemap">Sitemap</BaseLink>
		</nav>
		<!--
		  Deployment Info (visible for all contributors):
		  {SITE_DEPLOYMENT_INFO.siteUrl} | base: {SITE_DEPLOYMENT_INFO.base}
		  See src/SITE_DEPLOYMENT_INFO.ts for details.
		-->
		<slot />
		<footer class="site-footer text-center py-8 mt-12 border-t border-gray-200">
			<CommonFooterImports>
				<p class="text-sm subheader-text">&copy; {new Date().getFullYear()} Kairin's Astro Site &mdash; <BaseLink href="/sitemap">Sitemap</BaseLink></p>
			</CommonFooterImports>
		</footer>
	</body>
</html>