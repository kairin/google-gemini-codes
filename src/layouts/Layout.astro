---
// src/layouts/Layout.astro
import '../styles/global.css';
import SITE_DEPLOYMENT_INFO from '@/SITE_DEPLOYMENT_INFO.ts'; // Source of truth for deployment settings
import DeploymentInfo from '@/components/DeploymentInfo.astro'; // Deployment info component
// Favicon is in public/, so do NOT import it. Use Astro.base for the path.

interface Props {
	title: string;
}

const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<!--
		  Favicon is in public/, so reference it using Astro.base for correct subdirectory deployment.
		  Do NOT import favicon from src/assets/.
		  Always use {Astro.base} directly in the template for public assets.
		-->
		<link rel="icon" type="image/svg+xml" href={`${Astro.base}/favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<DeploymentInfo />
	</head>
	<body>
		<!--
		  Deployment Info (visible for all contributors):
		  {SITE_DEPLOYMENT_INFO.siteUrl} | base: {SITE_DEPLOYMENT_INFO.base}
		  See src/SITE_DEPLOYMENT_INFO.ts for details.
		-->
		<slot />
	</body>
</html>