---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Astro Rebuild Plan: Main Index">
    <div class="container mx-auto px-4 py-10 sm:py-16">
        <header class="text-center mb-12">
            <h1 class="text-4xl sm:text-5xl font-bold header-text leading-tight">A Strategic Blueprint for Rebuilding Your Astro Website</h1>
            <p class="mt-4 text-lg subheader-text max-w-3xl mx-auto">From Broken Animations to a Robust, Foolproof Deployment. Select a section below to begin.</p>
        </header>
        <main>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Card 1 -->
                <a href="/google-gemini-codes/section-1/" class="card rounded-lg p-6 block transition-all duration-200">
                    <p class="text-sm font-semibold accent-text">Section 1</p>
                    <h3 class="text-xl font-bold header-text mt-1">Project Restart</h3>
                    <p class="subheader-text mt-2">Re-establishing our foundation and confirming our technology choices.</p>
                </a>
                <!-- Card 2 -->
                <a href="/google-gemini-codes/section-2/" class="card rounded-lg p-6 block transition-all duration-200">
                    <p class="text-sm font-semibold accent-text">Section 2</p>
                    <h3 class="text-xl font-bold header-text mt-1">The Astro Philosophy</h3>
                    <p class="subheader-text mt-2">A deep dive into first principles, including the Islands Architecture.</p>
                </a>
                <!-- Card 3 -->
                <a href="/google-gemini-codes/section-3/" class="card rounded-lg p-6 block transition-all duration-200">
                    <p class="text-sm font-semibold accent-text">Section 3</p>
                    <h3 class="text-xl font-bold header-text mt-1">Diagnosing the Failure</h3>
                    <p class="subheader-text mt-2">A post-mortem on the broken animations and likely failure scenarios.</p>
                </a>
                <!-- Card 4 -->
                <a href="/google-gemini-codes/section-4/" class="card rounded-lg p-6 block transition-all duration-200" style="border-width: 2px; border-color: #2563EB;">
                    <p class="text-sm font-semibold accent-text">Section 4</p>
                    <h3 class="text-xl font-bold header-text mt-1">The Foolproof Plan</h3>
                    <p class="subheader-text mt-2">The step-by-step guide to rebuilding the site, from setup to deployment.</p>
                </a>
                <!-- Card 5 -->
                <a href="/google-gemini-codes/section-5/" class="card rounded-lg p-6 block transition-all duration-200">
                    <p class="text-sm font-semibold accent-text">Section 5</p>
                    <h3 class="text-xl font-bold header-text mt-1">Advanced Topics</h3>
                    <p class="subheader-text mt-2">Future-proofing with debugging, security (CSP), and performance insights.</p>
                </a>
                <!-- Card 6 -->
                <a href="/google-gemini-codes/section-6/" class="card rounded-lg p-6 block transition-all duration-200">
                    <p class="text-sm font-semibold accent-text">Section 6</p>
                    <h3 class="text-xl font-bold header-text mt-1">Checklist & Summary</h3>
                    <p class="subheader-text mt-2">Final recommendations and the definitive project rebuild checklist.</p>
                </a>
            </div>
            <div class="mt-12 text-center">
                 <a href="/google-gemini-codes/sources/" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-lg">View Consolidated Sources</a>
            </div>
        </main>
        <footer class="text-center py-8 mt-12 footer">
            <p class="text-sm subheader-text">Astro Rebuild Guide | Index</p>
        </footer>
    </div>
</Layout>
