---
// src/pages/index.astro
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import BaseLink from '@/components/BaseLink.astro';

// SOURCE OF TRUTH: Always use Astro.base for all internal links and asset paths.
// - This ensures correct navigation and resource loading in both local and subdirectory deployments (e.g., GitHub Pages).
// - Never use root-relative paths like /projects/ or /favicon.svg directly.
// - If Astro.base is ever undefined, fallback to '' (root-relative) to avoid /undefined/ URLs.
// - See src/SITE_DEPLOYMENT_INFO.ts for more details.

const allProjects = await getCollection('projects');
const base = typeof Astro.base === 'string' ? Astro.base : '';
---
<Layout title="Kairin's Projects">
    <div class="container mx-auto px-4 py-10 sm:py-16">
        <header class="text-center mb-12">
            <h1 class="text-4xl sm:text-5xl font-bold header-text leading-tight">My Projects & Living Documents</h1>
            <p class="mt-4 text-lg subheader-text max-w-3xl mx-auto">A collection of things I'm building and learning.</p>
        </header>
        <main>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {/*
                  Use Astro.base to ensure project links work in both local and GitHub Pages subdirectory deployments.
                  Defensive: If Astro.base is undefined, fallback to '' (root-relative).
                */}
                {allProjects.map(project => (
                    <BaseLink href={`/projects/${project.slug}/1`} class="card rounded-lg p-6 block transition-all duration-200">
                        <p class="text-sm font-semibold accent-text">
                            {project.data.pubDate.toDateString()}
                        </p>
                        <h3 class="text-xl font-bold header-text mt-1">{project.data.title}</h3>
                        <p class="subheader-text mt-2">{project.data.description}</p>
                    </BaseLink>
                ))}
            </div>
        </main>
        <footer class="text-center py-8 mt-12 footer">
            <p class="text-sm subheader-text">Generated on {new Date().toLocaleDateString()}</p>
        </footer>
    </div>
</Layout>
