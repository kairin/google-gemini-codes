---
// src/pages/index.astro
import Layout from '@/layouts/Layout.astro';
import ProjectCard from '@/components/cards/ProjectCard.astro';

const allProjects = await Astro.glob('../data/content-index/project-*.json');
---
<Layout title="Kairin's Projects">
    <div class="container mx-auto px-4 py-10 sm:py-16">
        <header class="text-center mb-12">
            <h1 class="text-4xl sm:text-5xl font-bold header-text leading-tight">My Projects & Living Documents</h1>
            <p class="mt-4 text-lg subheader-text max-w-3xl mx-auto">A collection of things I'm building and learning.</p>
        </header>
        <main>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {allProjects.map(project => (
                    <ProjectCard project={{ data: project, slug: project.slug }} />
                ))}
            </div>
        </main>
        <footer class="text-center py-8 mt-12 footer">
            <p class="text-sm subheader-text">Generated on {new Date().toLocaleDateString()}</p>
        </footer>
    </div>
</Layout>
