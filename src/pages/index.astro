---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
---
<Layout title="Astro Rebuild Plan: Main Index">
    <div class="container mx-auto px-4 py-10 sm:py-16">
        <!-- Page Header -->
        <header class="text-center mb-12">
            <h1 class="text-4xl sm:text-5xl font-bold">A Strategic Blueprint for Rebuilding Your Astro Website</h1>
            <p class="mt-4 text-lg text-gray-600 dark:text-gray-400 max-w-3xl mx-auto">From Broken Animations to a Robust, Foolproof Deployment. Select a section below to begin.</p>
        </header>
        
        <!-- Page Main Content -->
        <main>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Card links will be fixed in the next step -->
                <a href="#" class="p-6 border rounded-lg">Section 1: Project Restart</a>
                <a href="#" class="p-6 border rounded-lg">Section 2: The Astro Philosophy</a>
                <a href="#" class="p-6 border rounded-lg">Section 3: Diagnosing the Failure</a>
                <!-- ... more cards ... -->
            </div>
        </main>

        <!-- Page Footer -->
        <footer class="text-center py-8 mt-12 border-t">
            <p class="text-sm text-gray-500">Astro Rebuild Guide | Index</p>
        </footer>
    </div>
</Layout>
