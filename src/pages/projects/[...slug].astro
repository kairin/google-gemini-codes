---
// src/pages/projects/[...slug].astro
import Layout from '@/layouts/Layout.astro';
import SectionedMarkdown from '@/components/SectionedMarkdown.astro';
// Import project JSON assets
import projectAstroRebuildGuide from '@/data/content-index/project-astro-rebuild-guide.json';

export async function getStaticPaths() {
  const projects = [projectAstroRebuildGuide];
  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const rawContent = project.body || '';
const sectionIndex = 0; // Placeholder: parse from params if needed
const baseUrl = `/projects/${project.slug}`;
---
<Layout title={project.title}>
  <SectionedMarkdown rawContent={rawContent} sectionIndex={sectionIndex} baseUrl={baseUrl} />
</Layout>