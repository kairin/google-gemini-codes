---
// PROTECTED: Do not access or edit this file unless explicitly instructed.
import Layout from '@/layouts/Layout.astro';
import SectionedMarkdown from '@/components/SectionedMarkdown.astro';
import { getProjectStaticPaths } from '@/utils/getStaticPaths.js';

export async function getStaticPaths() {
  return getProjectStaticPaths();
}

const { project, sectionIndex = 0 } = Astro.props;
const rawContent = project.body || '';
const baseUrl = `/projects/${project.slug}`;
const sections = project.sections || [];
---
<Layout title={project.title}>
  <SectionedMarkdown rawContent={rawContent} sectionIndex={sectionIndex} baseUrl={baseUrl} sections={sections} />
</Layout>