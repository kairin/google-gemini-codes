---
// src/pages/projects/[...slug].astro
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { marked } from 'marked';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const paths = [];
  for (const project of projects) {
    const rawContent = project.body;
    const sections = rawContent.split(/\n---pagebreak---\n/);
    for (let i = 0; i < sections.length; i++) {
      paths.push({
        params: { slug: `${project.slug}/${i + 1}` },
        props: { project, sectionIndex: i },
      });
    }
    paths.push({
      params: { slug: project.slug },
      props: { project, sectionIndex: 0, redirect: true },
    });
  }
  return paths;
}

const { project, sectionIndex = 0, redirect = false } = Astro.props;
const rawContent = project.body;
const sections = rawContent.split(/\n---pagebreak---\n/);

// Only use Astro.base if it is defined and not already in the path
const base = Astro.base || '';

if (redirect && Astro.request.url && !Astro.request.url.endsWith('/1')) {
  // Avoid double base or undefined in redirect
  const redirectUrl = `${base}/projects/${project.slug}/1`.replace(/\/+/g, '/');
  return Astro.redirect(redirectUrl);
}

const menu = sections.map((section, idx) => {
  const match = section.match(/^#\s+(.+)$|^##\s+(.+)$/m);
  return {
    title: match ? (match[1] || match[2]) : `Section ${idx + 1}`,
    url: `${base}/projects/${project.slug}/${idx + 1}`.replace(/\/+/g, '/'),
    isActive: idx === sectionIndex,
  };
});

const sectionHtml = marked.parse(sections[sectionIndex] || '');
---
<Layout title={project.data.title}>
  <nav class="mb-8 flex flex-wrap gap-2">
    {menu.map(item => (
      <a href={item.url} class={item.isActive ? 'font-bold underline text-blue-700' : 'text-blue-600 hover:underline'}>{item.title}</a>
    ))}
  </nav>
  <main class="prose mx-auto px-4 py-10">
    <h1>{project.data.title}</h1>
    <p>{project.data.description}</p>
    <hr />
    <div innerHTML={sectionHtml} />
  </main>
</Layout>