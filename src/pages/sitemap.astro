---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
const projects = await getCollection('projects');
const blogPosts = await getCollection('blog');
---
<Layout title="Sitemap">
  <div class="container mx-auto px-4 py-10 sm:py-16">
    <h1 class="text-3xl font-bold mb-8">Sitemap</h1>
    <section class="mb-10">
      <h2 class="text-xl font-semibold mb-2">Projects</h2>
      <ul class="list-disc ml-6">
        {projects.map(project => (
          <li><a href={`/projects/${project.slug}/1`}>{project.data.title}</a></li>
        ))}
      </ul>
    </section>
    <section class="mb-10">
      <h2 class="text-xl font-semibold mb-2">Blog</h2>
      <ul class="list-disc ml-6">
        {blogPosts.map(post => (
          <li><a href={`/blog/${post.slug}`}>{post.data.title}</a></li>
        ))}
      </ul>
    </section>
    <section>
      <h2 class="text-xl font-semibold mb-2">Other</h2>
      <ul class="list-disc ml-6">
        <li><a href="/">Home</a></li>
        <li><a href="/sitemap">Sitemap</a></li>
      </ul>
    </section>
  </div>
</Layout>
