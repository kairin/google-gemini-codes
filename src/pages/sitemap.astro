---
import Layout from '@/layouts/Layout.astro';
import SitemapList from '@/components/lists/SitemapList.astro';
// Import all project and blog JSON assets
import projectAstroRebuildGuide from '@/data/content-index/project-astro-rebuild-guide.json';
// TODO: Import all other project and blog JSON files as needed

const projects = [projectAstroRebuildGuide]; // Add other imported projects here
const blogPosts = []; // Add imported blog JSON files here

const projectItems = projects.map(project => ({
  title: project.title,
  url: `/projects/${project.slug}/1`,
  pubDateLocal: project.pubDateLocal,
  pubDate: project.pubDate,
}));
const blogItems = blogPosts.map(post => ({
  title: post.title,
  url: `/blog/${post.slug}/1`,
  pubDateLocal: post.pubDateLocal,
  pubDate: post.pubDate,
}));
const otherItems = [
  { title: 'Home', url: '/' },
  { title: 'Documentation', url: '/docs' },
  { title: 'File Tree Map', url: '/tree' },
  { title: 'File Relationships', url: '/relationships' },
  { title: 'Protected Files', url: '/PROTECTED_FILES.txt' },
  { title: 'README (Markdown)', url: '/README.md' },
  { title: 'Full Documentation (Markdown)', url: '/DOCUMENTATION.md' },
  { title: 'Linking Guide', url: '/LINKING_GUIDE.md' },
];
---
<Layout title="Sitemap">
  <div class="container mx-auto px-4 py-10 sm:py-16">
    <h1 class="text-3xl font-bold mb-8">Sitemap</h1>
    <section class="mb-10">
      <SitemapList items={projectItems} title="Projects" />
    </section>
    <section class="mb-10">
      <SitemapList items={blogItems} title="Blog" />
    </section>
    <section>
      <SitemapList items={otherItems} title="Other" />
    </section>
  </div>
</Layout>
