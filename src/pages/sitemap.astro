---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import SitemapList from '@/components/lists/SitemapList.astro';

const projects = await getCollection('projects');
const blogPosts = await getCollection('blog');

const projectItems = projects.map(project => ({
  title: project.data.title,
  url: `/projects/${project.slug}/1`,
}));
const blogItems = blogPosts.map(post => ({
  title: post.data.title,
  url: `/blog/${post.slug}`,
}));
const otherItems = [
  { title: 'Home', url: '/' },
  { title: 'Sitemap', url: '/sitemap' },
];
---
<Layout title="Sitemap">
  <div class="container mx-auto px-4 py-10 sm:py-16">
    <h1 class="text-3xl font-bold mb-8">Sitemap</h1>
    <section class="mb-10">
      <SitemapList items={projectItems} title="Projects" />
    </section>
    <section class="mb-10">
      <SitemapList items={blogItems} title="Blog" />
    </section>
    <section>
      <SitemapList items={otherItems} title="Other" />
    </section>
  </div>
</Layout>
