---
// PROTECTED: Do not access or edit this file unless explicitly instructed.
import Layout from '@/layouts/Layout.astro';
import SectionedMarkdown from '@/components/SectionedMarkdown.astro';
import BaseLink from '@/components/BaseLink.astro';
import { getBlogStaticPaths } from '@/utils/getStaticPaths.js';

export async function getStaticPaths() {
  return getBlogStaticPaths();
}

const { post, sectionIndex = 0, blogslug = [] } = Astro.props;
const rawContent = post.body || '';
const baseUrl = `/blog/${post.slug}`;
const sections = post.sections || [];
---
<Layout title={post ? post.title : ''}>
  <main class="prose mx-auto px-4 py-10">
    <h1>{post ? post.title : ''}</h1>
    <p>{post ? post.description : ''}</p>
    <hr />
    <SectionedMarkdown rawContent={rawContent} sectionIndex={sectionIndex} baseUrl={baseUrl} sections={sections} />
    <nav class="mt-8">
      <BaseLink href="/">← Back to Home</BaseLink>
      <BaseLink href="/sitemap" class="ml-4">Sitemap</BaseLink>
    </nav>
  </main>
</Layout>