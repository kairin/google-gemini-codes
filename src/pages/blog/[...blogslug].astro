---
// src/pages/blog/[...blogslug].astro
import Layout from '@/layouts/Layout.astro';
import { marked } from 'marked';
import BaseLink from '@/components/BaseLink.astro';
// Import blog JSON assets
import blogFirstPost from '@/data/content-index/blog-first-post.json';
import blogHowToAddProjectsOnline from '@/data/content-index/blog-how-to-add-projects-online.json';

export async function getStaticPaths() {
  const blogs = [blogFirstPost, blogHowToAddProjectsOnline];
  return blogs.map(post => ({
    params: { blogslug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const html = post ? marked.parse(post.body || '') : '';
---
<Layout title={post ? post.title : ''}>
  <main class="prose mx-auto px-4 py-10">
    <h1>{post ? post.title : ''}</h1>
    <p>{post ? post.description : ''}</p>
    <hr />
    <div innerHTML={html} />
    <nav class="mt-8">
      <BaseLink href="/">← Back to Home</BaseLink>
      <BaseLink href="/sitemap" class="ml-4">Sitemap</BaseLink>
    </nav>
  </main>
</Layout>