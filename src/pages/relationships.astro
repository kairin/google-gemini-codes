---
import Layout from '@/layouts/Layout.astro';
import FileRelationships from '@/components/FileRelationships.jsx';
---
<Layout title="File Relationships Visualization">
  <main class="prose mx-auto px-4 py-10">
    <h1>File Relationships</h1>
    <p>This page visualizes imports and internal links between files in the codebase. Use the search to filter files, and click a filename to expand its relationships.</p>
    <FileRelationships client:load />
  </main>
</Layout>
