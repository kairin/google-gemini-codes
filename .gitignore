# Ignore node_modules and build output
node_modules/
dist/
.build/
.cache/

# Ignore environment files
.env
.env.*

# Ignore log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore self-hosted runner and related binaries
actions-runner/
*.tar.gz
*.log

# Ignore VS Code settings
.vscode/

# Ignore coverage and test output
coverage/
*.lcov

# Ignore data and generated files (if not needed in repo)
src/data/site-tree.json
src/data/file-relationships.json

# Ignore any other large or temporary files
*.tmp
*.swp
